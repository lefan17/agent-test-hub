# 配置档案：staging（预发/联调环境）
#
# 用法：AGENTTEST_ENV=staging python -m agenttest run
#
# 与 dev 的差异：
#   - 被测系统指向预发部署，端口 5002（与本地 dev 实例并存不冲突）
#   - 报告写入独立目录，避免与 dev 产物互相覆盖
#   - UI 后端固定 selenium（预发机器的 Chrome 路径不固定，用驱动更稳）
#
# 优先级：真实环境变量（含 .env） > 本文件 > 代码默认值

AGENTTEST_DEMO_URL=http://127.0.0.1:5002
AGENTTEST_UI_BACKEND=selenium
AGENTTEST_LLM_MODEL=deepseek-chat
AGENTTEST_REPORT_DIR=reports/staging
