# 配置档案：prod（生产/准生产验证环境）
#
# 用法：AGENTTEST_ENV=prod python -m agenttest run --no-ui
#
# 与 dev 的差异：
#   - 被测系统指向生产（或准生产）地址，默认关闭 UI 用例以免在被测系统上
#     产生浏览器级副作用，仅做只读 API / RAG 契约验证
#   - 重试次数收紧到 1，避免对生产接口放大流量
#   - 报告写入独立目录，便于归档与审计
#   - LLM Key 一律走环境变量注入，**不写进本文件**（档案文件会入库）
#
# 优先级：真实环境变量（含 .env） > 本文件 > 代码默认值

AGENTTEST_DEMO_URL=https://todo.example.com
AGENTTEST_UI_BACKEND=selenium
AGENTTEST_LLM_MODEL=deepseek-chat
AGENTTEST_REPORT_DIR=reports/prod
AGENTTEST_MAX_ATTEMPTS=1
