{
  "openapi": "3.0.3",
  "info": {
    "title": "AgentTest Demo API",
    "version": "1.0.0",
    "description": "供 Agent 自动测试演示的待办清单服务契约。实现若与契约不符即为缺陷。"
  },
  "servers": [{ "url": "http://127.0.0.1:5001" }],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "健康检查",
        "responses": {
          "200": { "description": "服务正常", "content": { "application/json": { "example": { "status": "ok", "version": "1.0.0" } } } }
        }
      }
    },
    "/api/login": {
      "post": {
        "summary": "登录获取 token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["username", "password"],
                "properties": { "username": { "type": "string" }, "password": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "登录成功，返回 token" },
          "400": { "description": "缺少用户名或密码" },
          "401": { "description": "用户名或密码错误" }
        }
      }
    },
    "/api/todos": {
      "get": {
        "summary": "查询待办列表",
        "parameters": [
          { "name": "status", "in": "query", "required": false, "schema": { "type": "string", "enum": ["active", "done"] } }
        ],
        "responses": {
          "200": { "description": "待办列表" },
          "400": { "description": "status 参数非法（契约要求 400）" }
        }
      },
      "post": {
        "summary": "创建待办",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["title"],
                "properties": {
                  "title": { "type": "string", "minLength": 1 },
                  "priority": { "type": "string", "enum": ["low", "medium", "high"], "default": "medium" }
                }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "创建成功" },
          "400": { "description": "title 为空或 priority 非法（契约要求 400）" }
        }
      }
    },
    "/api/todos/{id}": {
      "get": {
        "summary": "查询单个待办",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "200": { "description": "待办详情" },
          "404": { "description": "不存在" }
        }
      },
      "patch": {
        "summary": "更新待办状态",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": { "status": { "type": "string", "enum": ["active", "done"] } }
              }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" },
          "400": { "description": "status 非法" },
          "404": { "description": "不存在" }
        }
      },
      "delete": {
        "summary": "删除待办",
        "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "integer" } }],
        "responses": {
          "204": { "description": "删除成功" },
          "404": { "description": "不存在" }
        }
      }
    },
    "/api/flaky": {
      "get": {
        "summary": "不稳定服务（约 10% 概率 503，用于演示重试机制）",
        "responses": {
          "200": { "description": "成功" },
          "503": { "description": "服务暂时不可用" }
        }
      }
    },
    "/api/stats": {
      "get": {
        "summary": "待办统计",
        "responses": { "200": { "description": "统计信息" } }
      }
    },
    "/api/rag/search": {
      "get": {
        "summary": "RAG 检索（默认 BM25 后端，离线确定性）",
        "parameters": [
          { "name": "q", "in": "query", "required": true, "schema": { "type": "string", "minLength": 1, "maxLength": 200 } },
          { "name": "top_k", "in": "query", "required": false, "schema": { "type": "integer", "minimum": 1, "maximum": 50, "default": 5 } }
        ],
        "responses": {
          "200": {
            "description": "检索成功，hits 按 score 降序且 rank 从 1 连续；同一 doc_id 不重复出现",
            "content": {
              "application/json": {
                "example": {
                  "query": "向量数据库",
                  "top_k": 5,
                  "hits": [{ "doc_id": "DOC-CN-002", "score": 3.21, "rank": 1, "text": "向量数据库支持语义检索与相似度计算。" }],
                  "index": { "backend": "bm25", "size": 11, "version": 1 }
                }
              }
            }
          },
          "400": { "description": "q 缺失或为空、q 超长（>200）、top_k 非正整数或超过上限 50" }
        }
      }
    },
    "/api/rag/index": {
      "get": {
        "summary": "索引与语料元信息（backend / size / version / doc_ids）",
        "responses": {
          "200": {
            "description": "索引元信息；index_size 与 size 不一致即为索引陈旧",
            "content": {
              "application/json": {
                "example": {
                  "backend": "bm25", "size": 11, "version": 1,
                  "doc_ids": ["DOC-CN-001"], "index_size": 11,
                  "requested_backend": "bm25", "fallback": ""
                }
              }
            }
          }
        }
      }
    },
    "/api/rag/reindex": {
      "post": {
        "summary": "依据当前语料重建索引，返回新的 version（用于验证索引与语料一致性）",
        "responses": {
          "200": {
            "description": "重建完成",
            "content": {
              "application/json": {
                "example": { "reindexed": true, "version": 2, "size": 11, "backend": "bm25" }
              }
            }
          }
        }
      }
    },
    "/api/rag/docs": {
      "post": {
        "summary": "新增语料文档（用于验证索引增删同步）",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["doc_id", "text"],
                "properties": { "doc_id": { "type": "string" }, "text": { "type": "string" } }
              }
            }
          }
        },
        "responses": {
          "201": { "description": "创建成功，version 递增" },
          "400": { "description": "doc_id 或 text 为空" },
          "409": { "description": "doc_id 已存在" }
        }
      }
    },
    "/api/rag/docs/{doc_id}": {
      "patch": {
        "summary": "更新语料文档正文",
        "parameters": [{ "name": "doc_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "type": "object", "required": ["text"], "properties": { "text": { "type": "string" } } }
            }
          }
        },
        "responses": {
          "200": { "description": "更新成功" },
          "404": { "description": "doc_id 不存在" }
        }
      },
      "delete": {
        "summary": "删除语料文档（删除后不得再被召回）",
        "parameters": [{ "name": "doc_id", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "删除成功" },
          "404": { "description": "doc_id 不存在" }
        }
      }
    }
  }
}
