# ===== 环境分层：dev | staging | prod =====
# 选中一套配置档案，档案文件在 scripts/env/<profile>.env。
#
# 取值优先级（从高到低）：
#   1. 真实环境变量（含本文件 .env，由 agenttest/config.py 的 _load_dotenv 注入）
#   2. AGENTTEST_ENV 选中的档案文件 scripts/env/<profile>.env
#   3. 代码内默认值（agenttest/config.py 的 Config）
#
# 默认 dev，且 scripts/env/dev.env 的取值与代码默认值逐条一致，
# 因此不设置 AGENTTEST_ENV（也不设本文件任何变量）时的行为
# 与引入环境分层之前完全相同。
#
# 用法：
#   AGENTTEST_ENV=staging python -m agenttest run
#   AGENTTEST_ENV=prod    python -m agenttest run --no-ui
#
# 未设置或取值不在 dev/staging/prod 之内时：默认 dev；写错值会直接
# ValueError（明确报错优于静默跑错环境）。
# AGENTTEST_ENV=dev

# ===== LLM 配置（OpenAI 兼容接口；不配置则自动降级为 MockBrain，离线可跑）=====
# 示例：DeepSeek
# AGENTTEST_LLM_API_KEY=sk-xxxx
# AGENTTEST_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENTTEST_LLM_MODEL=deepseek-chat
# 示例：OpenAI
# AGENTTEST_LLM_API_KEY=sk-xxxx
# AGENTTEST_LLM_BASE_URL=https://api.openai.com/v1
# AGENTTEST_LLM_MODEL=gpt-4o-mini
#
# 注意：本文件会被 .gitignore 忽略，但 scripts/env/prod.env 是**入库**的，
# 所以 LLM Key 一律只写在这里或环境变量里，绝不写进档案文件。

# ===== 被测系统 =====
AGENTTEST_DEMO_URL=http://127.0.0.1:5001

# ===== UI 自动化后端：auto | chrome | selenium =====
# chrome : 使用系统 Chrome 无头模式（--dump-dom / 截图），无需额外驱动，默认推荐
# selenium: 需要 chromedriver 可用（Selenium Manager 自动下载或 PATH 中存在）
AGENTTEST_UI_BACKEND=auto
# AGENTTEST_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# ===== 报告与重试（可选覆盖）=====
# AGENTTEST_REPORT_DIR=reports
# AGENTTEST_MAX_ATTEMPTS=3
# AGENTTEST_MAX_PLAN_ROUNDS=2
