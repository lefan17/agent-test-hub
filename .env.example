# ===== LLM 配置（OpenAI 兼容接口；不配置则自动降级为 MockBrain，离线可跑）=====
# 示例：DeepSeek
# AGENTTEST_LLM_API_KEY=sk-xxxx
# AGENTTEST_LLM_BASE_URL=https://api.deepseek.com/v1
# AGENTTEST_LLM_MODEL=deepseek-chat
# 示例：OpenAI
# AGENTTEST_LLM_API_KEY=sk-xxxx
# AGENTTEST_LLM_BASE_URL=https://api.openai.com/v1
# AGENTTEST_LLM_MODEL=gpt-4o-mini

# ===== 被测系统 =====
AGENTTEST_DEMO_URL=http://127.0.0.1:5001

# ===== UI 自动化后端：auto | chrome | selenium =====
# chrome : 使用系统 Chrome 无头模式（--dump-dom / 截图），无需额外驱动，默认推荐
# selenium: 需要 chromedriver 可用（Selenium Manager 自动下载或 PATH 中存在）
AGENTTEST_UI_BACKEND=auto
# AGENTTEST_CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe
